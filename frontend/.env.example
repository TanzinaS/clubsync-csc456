# Flask API origin, without /api (for example, http://127.0.0.1:5001).
# Empty or unset uses http://127.0.0.1:5001. Production uses the Render service URL.
# Vite exposes this value to the browser; do not put secrets here.
# Restart Vite after changing this value; production changes require a rebuild.
VITE_API_BASE_URL=
